{
  "name": "ride-the-music",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:static && npm run test:integration && npm run db:migrate:test",
    "test:unit": "tsx --test test/artist-discography.test.ts test/cover-tilt.test.ts test/cursor-pagination.test.ts test/home-search.test.ts test/home-search-cache.test.ts test/home-search-url.test.ts test/profile-tabs.test.ts test/review-tags.test.ts test/search-request.test.ts test/security-hardening-unit.test.ts",
    "test:static": "tsx --test test/a11y-theme.test.ts test/auth-session-sync.test.ts test/i18n-messages.test.ts test/motion-interactions.test.ts test/review-favorite-track.test.ts test/ui-foundations.test.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "db:validate": "prisma validate",
    "db:migrate:local:create": "prisma migrate dev",
    "db:migrate:local:create-only": "prisma migrate dev --create-only",
    "db:migrate:local:deploy": "prisma migrate deploy",
    "db:migrate:local:status": "prisma migrate status",
    "db:migrate:remote:status": "tsx scripts/turso-migrate.ts status",
    "db:migrate:remote:apply": "tsx scripts/turso-migrate.ts apply",
    "db:migrate:remote:adopt": "tsx scripts/turso-migrate.ts adopt",
    "db:migrate:compensation-plan": "tsx scripts/migration-compensation.ts",
    "db:migrate:test": "npm run db:migrate:test:history && npm run db:migrate:test:ratings && npm run db:migrate:test:comments && npm run db:migrate:test:invariants && npm run db:migrate:test:sessions",
    "db:migrate:test:history": "tsx --test test/database-migrations.test.ts",
    "db:migrate:test:ratings": "tsx --test test/rating-migration.test.ts",
    "db:migrate:test:comments": "tsx --test test/comment-idempotency-migration.test.ts",
    "db:migrate:test:invariants": "tsx --test test/data-invariants-migration.test.ts",
    "db:migrate:test:sessions": "tsx --test test/revocable-sessions-migration.test.ts",
    "test:auth": "tsx --test test/auth-route-handlers.test.ts test/revocable-sessions.test.ts test/account-emails.test.ts",
    "db:ratings:diagnose": "tsx scripts/rating-duplicates.ts",
    "test:diary": "tsx --test test/diary-events.test.ts",
    "test:ratings": "tsx --test test/rating-integrity.test.ts",
    "test:playlists": "tsx --test test/playlist-import.test.ts",
    "test:social": "tsx --test test/social-actions.test.ts",
    "perf:user-derived-cache": "tsx scripts/perf-user-derived-cache.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "next": "14.2.35",
    "next-intl": "^4.13.1",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
