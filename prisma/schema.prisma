// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String   @id @default(uuid())
  username            String   @unique
  email               String   @unique
  password            String   // bcrypt hash
  credentialsVersion  Int      @default(0)
  bio                 String?
  favoriteGenre       String?
  profileImage        String?
  favoriteAlbums      FavoriteAlbum[]
  profileColor        String?  @default("emerald")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  reviews             Review[]
  ratings             Rating[]
  following           Follow[] @relation("following")
  followers           Follow[] @relation("followers")
  favoriteTracks      FavoriteTrack[]
  lists               List[]
  comments            Comment[]
  reviewLikes         ReviewLike[]
  diaryLogs           DiaryLog[]
  listenLaterList     ListenLater[]
  notifications       Notification[]
  earnedBadges        EarnedBadge[]
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  knownDevices        KnownDevice[]
}

model AuthSession {
  id                 String   @id
  userId             String
  credentialsVersion Int
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Only the SHA-256 of the emailed token is stored. A token is valid while it is
// unused, unexpired and the account still has the credentialsVersion it was issued for.
model PasswordResetToken {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  credentialsVersion Int
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  usedAt             DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Browsers that already signed in to an account, identified by the SHA-256 of a
// random device cookie. No IP address or user agent is persisted.
model KnownDevice {
  id         String   @id @default(uuid())
  userId     String
  deviceHash String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

model MusicItem {
  id          String   @id // e.g. local UUID or Spotify ID
  title       String
  artist      String
  type        String   // "ALBUM" or "SONG"
  coverUrl    String   // Album/Song cover image URL
  releaseYear Int
  tracks      String?  // JSON stringified list of track names or metadata (for albums)
  createdAt   DateTime @default(now())
  reviews     Review[]
  ratings     Rating[]
  favoriteTracks FavoriteTrack[]
  listItems      ListItem[]
  diaryLogs      DiaryLog[]
  listenLaterList ListenLater[]
  favoriteAlbums  FavoriteAlbum[]
}

model Review {
  id          String    @id @default(uuid())
  content     String
  ratingValue Float     // 0.5 to 5, increments of 0.5
  tags        String?   // comma separated mood tags
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String
  likes       ReviewLike[]
  comments    Comment[]

  @@index([userId, musicItemId])
  @@index([musicItemId, createdAt, id])
  @@index([createdAt, id])
}

model Rating {
  id          String    @id @default(uuid())
  value       Float     // 1 to 5, increments of 0.5
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String

  @@unique([userId, musicItemId])
}

model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model FavoriteTrack {
  id          String    @id @default(uuid())
  trackTitle  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String

  @@unique([userId, musicItemId])
}

model List {
  id          String     @id @default(uuid())
  title       String
  description String?
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  items       ListItem[]

  @@index([userId, createdAt, id])
  @@index([isPublic, createdAt, id])
}

model ListItem {
  id          String    @id @default(uuid())
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String

  @@unique([listId, musicItemId])
  @@index([listId])
  @@index([listId, order, id])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  operationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String

  @@index([reviewId, createdAt, id])
  @@unique([userId, operationId])
}

model ReviewLike {
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String

  @@id([userId, reviewId])
}

model DiaryLog {
  id          String    @id @default(uuid())
  listenedAt  DateTime  @default(now())
  ratingValue Float?
  notes       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String
  listenCount Int       @default(1) // Legacy: new rows always represent one event; values > 1 preserve known aggregate history.

  @@index([userId, musicItemId])
  @@index([userId, listenedAt])
  @@index([userId, listenedAt, id])
}

model ListenLater {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String

  @@unique([userId, musicItemId])
  @@index([userId, createdAt, id])
}

model FavoriteAlbum {
  id          String    @id @default(uuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  musicItem   MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
  musicItemId String
  slot        Int

  @@unique([userId, slot])
  @@unique([userId, musicItemId])
}

model Notification {
  id          String   @id @default(uuid())
  type        String   // "NEW_FOLLOWER", "NEW_LIKE", "NEW_COMMENT", etc.
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  sourceUserId String? // ID del usuario que originó la acción (ej: quien dio like)
  link        String?  // URL para redirigir (ej: /reviews/123)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, createdAt, id])
  @@index([userId, isRead, createdAt, id])
}

model EarnedBadge {
  id        String   @id @default(uuid())
  badgeId   String   // e.g., "FIRST_REVIEW", "TASTEMAKER"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, badgeId])
  @@index([userId])
}

model MusicEvent {
  id            String   @id @default(uuid())
  dateMonth     Int      // 1-12
  dateDay       Int      // 1-31
  artistName    String
  artistId      String   // ID del artista en la API de Deezer para poder buscar su música
  eventType     String   // Ej. "DEATH", "BIRTH", "ALBUM_RELEASE"
  description   String?  // Texto adicional (opcional)
  createdAt     DateTime @default(now())

  @@index([dateMonth, dateDay])
}
