DATABASE_URL="file:./dev.db"

# Turso (opcional). Mantener vacías en desarrollo SQLite local.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Confirmación operacional: host exacto de TURSO_DATABASE_URL.
# Sólo se define durante apply/adopt remoto; no es un secreto persistente.
MUSICBOX_MIGRATION_CONFIRM=""
JWT_SECRET="reemplaza_con_un_secreto_seguro_en_produccion"

# Proxies de confianza delante de la app que agregan su salto a X-Forwarded-For
# (p. ej. 1 detrás de un nginx con proxy_add_x_forwarded_for). En Vercel no hace
# falta. Vacío o 0: no se confía en ningún header de IP y el rate limit de login
# queda sólo por cuenta.
TRUSTED_PROXY_HOPS=""
